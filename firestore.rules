rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // This rule allows anyone with your Firestore database reference to view, edit,
    // and delete all data in your Firestore database. It is useful for getting
    // started, but it is configured to expire after 30 days because it
    // leaves your app open to attackers. At that time, all client
    // requests to your Firestore database will be denied.
    //
    // Make sure to write security rules for your app before that time, or else
    // all client requests to your Firestore database will be denied until you Update
    // your rules
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Patients can only read/write their own profile
    match /patients/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Consultations: Patients can read their own, doctors can write
    match /consultations/{consultationId} {
      allow read: if isAuthenticated() && (resource.data.patientId == request.auth.uid || request.auth.token.role == 'doctor');
      allow write: if isAuthenticated() && request.auth.token.role == 'doctor';
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}