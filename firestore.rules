rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role-based helper (Dr. Maryam)
    function isDoctor() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor';
    }

    // --- Collections ---

    // USERS: Prevent role escalation & protect clinical notes
    match /users/{userId} {
      allow read: if isOwner(userId) || isDoctor();
      
      // Strict update rule: Patients cannot change their own 'role'
      allow update: if isOwner(userId) && 
                      (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      
      allow create: if isAuthenticated(); // Initial creation on signup

      // CLINICAL NOTES: Highly sensitive, only Doctor can write
      match /notes/{noteId} {
        allow read: if isOwner(userId) || isDoctor();
        allow write: if isDoctor();
      }
    }

    // APPOINTMENTS: Isolation & Integrity
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isDoctor());
      
      // Patients can only create for themselves; Doctors can update status/zoom
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow update, delete: if isDoctor() || (isOwner(resource.data.patientId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['zoomLink']));
    }

    // MESSAGING: Participant isolation
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && 
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        allow create: if isAuthenticated();
      }
    }

    // LAB REQUESTS & PRESCRIPTIONS (Treated as standalone or user-linked)
    match /prescriptions/{pid} {
       allow read: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isDoctor());
       allow write: if isDoctor();
    }

    match /lab-requests/{lid} {
       allow read: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isDoctor());
       allow write: if isDoctor();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}